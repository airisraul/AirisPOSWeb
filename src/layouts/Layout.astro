---
import '@fontsource-variable/sora/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import { site, pricing, faqs } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Añade el bloque FAQPage al JSON-LD (solo en páginas que muestran esas preguntas). */
  includeFaqSchema?: boolean;
}

const {
  title = `${site.name} — TPV, KDS y reservas para restaurantes`,
  description = site.description,
  ogImage = '/og-image.png',
  includeFaqSchema = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

// Una oferta por plan con su cuota mensual (sin IVA).
const offers = pricing.plans.map((plan) => ({
  '@type': 'Offer',
  name: plan.name,
  description: plan.idealFor,
  price: plan.monthly.price,
  priceCurrency: pricing.currency,
  availability: 'https://schema.org/InStock',
  areaServed: { '@type': 'Country', name: 'España' },
  priceSpecification: {
    '@type': 'UnitPriceSpecification',
    price: plan.monthly.price,
    ...(plan.monthly.prefix ? { minPrice: plan.monthly.price } : {}),
    priceCurrency: pricing.currency,
    unitText: 'MONTH',
    valueAddedTaxIncluded: false,
  },
}));

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description,
  url: canonicalUrl,
  image: ogImageUrl,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'TPV / Punto de venta para hostelería',
  operatingSystem: 'Android',
  inLanguage: 'es-ES',
  featureList: [
    'Toma de comandas en tablet y TPV de barra',
    'Pantalla de cocina (KDS) con semáforo de tiempos',
    'Reservas online y plano de sala compartido',
    'Escandallos, margen por plato y control de stock',
    'Ventas por local, cadena y propietario',
    'División de cuentas y cambio de mesa',
    'Cierre de caja',
    'Validado Veri*Factu y TicketBAI (Gipuzkoa, Araba y Bizkaia)',
  ],
  offers,
  provider: {
    '@type': 'Organization',
    name: site.name,
    legalName: site.company,
    url: siteUrl.href,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const schemas = includeFaqSchema ? [softwareSchema, faqSchema] : [softwareSchema];
// Escapa "<" para que ningún texto pueda cerrar la etiqueta <script> del JSON-LD.
const toJsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0b1f1b" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Respeta la preferencia «animaciones en pausa» antes de pintar.
      try {
        if (localStorage.getItem('airis-motion') === 'paused') document.documentElement.dataset.motion = 'paused';
      } catch {}
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={toJsonLd(schema)} />)}
  </head>
  <body class="min-h-dvh font-sans">
    <a
      href="#contenido"
      class="sr-only z-[60] rounded-lg bg-ink px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>
    <slot />
    <script>
      // Botón «Pausar animaciones» (WCAG 2.2.2): pausa todos los bucles y recuerda la elección.
      const root = document.documentElement;
      const sync = () => {
        const paused = root.dataset.motion === 'paused';
        document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((button) => {
          const label = button.querySelector('[data-motion-label]');
          if (label) label.textContent = paused ? 'Reanudar animaciones' : 'Pausar animaciones';
        });
      };
      document.querySelectorAll('[data-motion-toggle]').forEach((button) =>
        button.addEventListener('click', () => {
          const paused = root.dataset.motion !== 'paused';
          if (paused) root.dataset.motion = 'paused';
          else delete root.dataset.motion;
          try {
            localStorage.setItem('airis-motion', paused ? 'paused' : 'running');
          } catch {}
          sync();
        }),
      );
      sync();

      // Ahorro: los bucles de cada sección solo corren mientras se ven.
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => entry.target.classList.toggle('offscreen', !entry.isIntersecting)),
        { rootMargin: '100px 0px' },
      );
      document.querySelectorAll('.loops').forEach((section) => observer.observe(section));
    </script>
    <!-- Vercel Web Analytics: sin cookies, se activa solo en el despliegue de Vercel. -->
    <Analytics />
  </body>
</html>
