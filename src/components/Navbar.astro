---
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { navLinks, whatsappUrl } from '../data/site';
---

<header class="theme-dark sticky top-0 z-40 border-b border-night-line bg-night">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:gap-3 sm:px-6 lg:h-18">
    <a href="/" class="rounded-lg" aria-label="AIRISPOS, ir al inicio">
      <Logo />
    </a>

    <nav class="site-nav order-last lg:order-none" aria-label="Principal">
      <button
        class="menu-button inline-flex min-h-12 min-w-12 items-center justify-center gap-2 rounded-lg px-2 font-semibold text-white hover:bg-white/5 sm:px-3 lg:hidden"
        type="button"
        popovertarget="site-menu"
        aria-controls="site-menu"
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span class="sr-only sm:not-sr-only">Menú</span>
      </button>

      <ul
        id="site-menu"
        popover="auto"
        class="site-menu rounded-2xl border border-night-line bg-night-card p-2 text-white shadow-xl"
      >
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-12 items-center rounded-lg px-4 font-semibold text-mist hover:bg-white/5 hover:text-white lg:min-h-10 lg:px-3"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 border-t border-night-line pt-2 lg:hidden">
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener"
            class="flex min-h-12 items-center gap-2 rounded-lg px-4 font-semibold text-whatsapp hover:bg-white/5"
          >
            <WhatsAppIcon />
            Escríbenos por WhatsApp
          </a>
        </li>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        class="hidden min-h-11 items-center gap-2 rounded-full border border-white/20 px-4 font-semibold text-white hover:bg-white/5 lg:inline-flex"
      >
        <WhatsAppIcon />
        WhatsApp
      </a>
      <a
        href="#contacto"
        class="btn-mint inline-flex min-h-11 items-center gap-1.5 rounded-full px-4 font-bold whitespace-nowrap sm:px-5"
      >
        Pedir demo
        <svg class="hidden size-4 min-[380px]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Navegadores sin Popover API: cargar el polyfill solo cuando haga falta.
  if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
    import('@oddbird/popover-polyfill');
  }

  // Al pulsar un enlace del menú móvil, cerrarlo para que se vea la sección de destino.
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('a')) return;
    if (menu.matches(':is(:popover-open, .\\:popover-open)')) menu.hidePopover();
  });
</script>
