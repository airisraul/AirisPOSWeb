---
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { navLinks, whatsappUrl } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:gap-3 sm:px-6 lg:h-18">
    <a href="/" class="rounded-lg" aria-label="AirisPOS, ir al inicio">
      <Logo />
    </a>

    <nav class="site-nav order-last lg:order-none" aria-label="Principal">
      <button
        class="menu-button inline-flex min-h-12 min-w-12 items-center justify-center gap-2 rounded-lg px-2 font-semibold text-ink hover:bg-slate-100 sm:px-3 lg:hidden"
        type="button"
        popovertarget="site-menu"
        aria-controls="site-menu"
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span class="sr-only sm:not-sr-only">Menú</span>
      </button>

      <ul
        id="site-menu"
        popover="auto"
        class="site-menu rounded-2xl border border-slate-200 bg-white p-2 shadow-xl"
      >
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-12 items-center rounded-lg px-4 font-semibold text-slate-700 hover:bg-slate-100 hover:text-ink lg:min-h-10 lg:px-3"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 border-t border-slate-200 pt-2 lg:hidden">
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener"
            class="flex min-h-12 items-center gap-2 rounded-lg px-4 font-semibold text-whatsapp-dark hover:bg-slate-100"
          >
            <WhatsAppIcon />
            Escríbenos por WhatsApp
          </a>
        </li>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        class="hidden min-h-11 items-center gap-2 rounded-xl border-2 border-whatsapp-dark px-4 font-semibold text-whatsapp-dark hover:bg-whatsapp-dark hover:text-white lg:inline-flex"
      >
        <WhatsAppIcon />
        WhatsApp
      </a>
      <a
        href="#contacto"
        class="inline-flex min-h-11 items-center rounded-xl bg-brand-700 px-3 font-bold whitespace-nowrap text-white shadow-sm hover:bg-brand-800 sm:px-4"
      >
        Pedir Demo<span class="hidden min-[380px]:inline">&nbsp;Gratis</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Navegadores sin Popover API: cargar el polyfill solo cuando haga falta.
  if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
    import('@oddbird/popover-polyfill');
  }

  // Al pulsar un enlace del menú móvil, cerrarlo para que se vea la sección de destino.
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('a')) return;
    if (menu.matches(':is(:popover-open, .\\:popover-open)')) menu.hidePopover();
  });
</script>
