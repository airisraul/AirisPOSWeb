---
import type { ImageMetadata } from 'astro';
import Screenshot from './Screenshot.astro';
import type { BusinessType } from '../data/site';
import cierreCaja from '../assets/capturas/cierre-caja.png';
import comandas from '../assets/capturas/comandas.png';
import pantallaCocina from '../assets/capturas/pantalla-cocina.png';

const images: Record<BusinessType, { src: ImageMetadata; alt: string; caption: string }> = {
  bar: {
    src: cierreCaja,
    alt: 'Pantalla de cierre de turno de AirisPOS con el total de ventas, el número de tickets, el desglose por forma de pago y el arqueo de caja con el efectivo esperado.',
    caption: 'Cierre de turno: ventas, formas de pago y arqueo de caja en una sola pantalla.',
  },
  restaurante: {
    src: comandas,
    alt: 'Toma de comanda en AirisPOS para la mesa T-30: carta por categorías con fotos y precios, y a la derecha el detalle de la cuenta con aviso de platos listos en cocina y botones para dividir la cuenta y pagar.',
    caption: 'Comanda de mesa con aviso de platos listos, notas para cocina y división de cuenta.',
  },
  delivery: {
    src: pantallaCocina,
    alt: 'Pantalla de cocina (KDS) de AirisPOS con los pedidos por mesa, el tiempo que lleva cada uno en preparación, los platos ya hechos tachados y un resumen global de lo pendiente.',
    caption: 'Pantalla de cocina: cada pedido con su tiempo de espera y lo que falta por preparar.',
  },
};

const tabs: { id: BusinessType; tab: string; title: string; intro: string; points: string[]; quote: string }[] = [
  {
    id: 'bar',
    tab: 'Bares y cafeterías',
    title: 'Para la barra que no para',
    intro: 'Cuando se llena la barra a la hora del café o del vermú, cada segundo cuenta.',
    points: [
      'Cobro ultrarrápido: producto, cobrar y listo, en 2 toques.',
      'Rondas: repite la última ronda de un cliente con un solo toque.',
      'Cuentas abiertas por cliente o por nombre, sin apuntar en papel.',
      'Cierre de caja ciega en 1 minuto, para que el cuadre no dependa de nadie.',
    ],
    quote: 'Ideal para bares de barrio, cafeterías, cervecerías y pubs.',
  },
  {
    id: 'restaurante',
    tab: 'Restaurantes y terrazas',
    title: 'Sala, terraza y cocina, coordinadas',
    intro: 'Que el camarero no tenga que ir y venir de la cocina y que ninguna mesa se quede olvidada.',
    points: [
      'Mapa visual de mesas por zonas: salón, terraza, reservados.',
      'Comanderos móviles: el camarero toma nota en la mesa con su móvil o tablet.',
      'Envío automático a cocina y barra, cada cosa a su impresora.',
      'Dividir cuentas por comensal, por productos o a partes iguales.',
    ],
    quote: 'Ideal para restaurantes, asadores, marisquerías y locales con terraza.',
  },
  {
    id: 'delivery',
    tab: 'Comida rápida y delivery',
    title: 'Pedidos claros y a tiempo',
    intro: 'Mucho volumen, poco margen de error y clientes que esperan su pedido ya.',
    points: [
      'Tickets claros para cocina, con modificadores y notas bien visibles.',
      'Control de tiempos: ves cuánto lleva cada pedido en cola.',
      'Pedidos para recoger, para llevar y a domicilio en la misma pantalla.',
      'Cobro rápido en mostrador, con efectivo o tarjeta.',
    ],
    quote: 'Ideal para hamburgueserías, pizzerías, kebabs, poke y take away.',
  },
];
---

<section id="sectores" class="bg-slate-50 py-16 sm:py-24" aria-labelledby="sectores-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="font-bold tracking-wide text-brand-700 uppercase">Sectores</p>
      <h2 id="sectores-title" class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        Cada local trabaja distinto. AirisPOS se adapta al tuyo
      </h2>
    </div>

    <div class="mt-10" data-tabs>
      <div
        role="tablist"
        aria-label="Tipos de negocio"
        class="-mx-4 flex gap-1 overflow-x-auto border-b border-slate-300 px-4 sm:mx-0 sm:px-0"
      >
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="relative min-h-12 shrink-0 px-4 py-3 font-bold whitespace-nowrap text-slate-600 hover:text-ink after:absolute after:inset-x-0 after:bottom-0 after:border-b-4 after:border-transparent aria-selected:text-brand-700 aria-selected:after:border-brand-700"
            >
              {t.tab}
            </button>
          ))
        }
      </div>

      <div class="grid">
        {
          tabs.map((t, i) => (
            <div
              role="tabpanel"
              id={`panel-${t.id}`}
              aria-labelledby={`tab-${t.id}`}
              tabindex={i === 0 ? 0 : undefined}
              hidden={i === 0 ? undefined : 'until-found'}
              class="[grid-area:1/1]"
            >
              <div class="grid items-start gap-8 py-8 lg:grid-cols-2 lg:gap-12">
                <div>
                  <h3 class="text-2xl font-bold text-ink">{t.title}</h3>
                  <p class="mt-2 text-lg text-slate-700">{t.intro}</p>
                  <ul class="mt-6 space-y-4">
                    {t.points.map((point) => (
                      <li class="flex gap-3">
                        <svg class="mt-0.5 size-6 shrink-0 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="m5 12 5 5L20 7" />
                        </svg>
                        <span class="text-slate-800">{point}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-8 flex flex-col gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:flex-row sm:items-center sm:justify-between">
                    <p class="font-semibold text-ink">{t.quote}</p>
                    <a
                      href="#licencias"
                      data-calc-type={t.id}
                      class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-ink px-5 font-bold text-white hover:bg-slate-800"
                    >
                      Calcular mi licencia
                    </a>
                  </div>
                </div>
                <figure>
                  <Screenshot
                    src={images[t.id].src}
                    alt={images[t.id].alt}
                    sizes="(min-width: 80rem) 600px, (min-width: 64rem) calc(50vw - 72px), calc(100vw - 32px)"
                    class="drop-shadow-xl"
                  />
                  <figcaption class="mt-3 text-center text-sm text-slate-600">{images[t.id].caption}</figcaption>
                </figure>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Pestañas accesibles: la selección sigue al foco (flechas, Inicio y Fin) y
  // los paneles ocultos usan hidden="until-found" para que Ctrl+F los encuentre.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = panels[i];
        if (selected) {
          panel.hidden = false;
          panel.tabIndex = 0;
        } else {
          // En navegadores sin soporte de until-found se comporta como hidden normal.
          panel.setAttribute('hidden', 'until-found');
          panel.removeAttribute('tabindex');
        }
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        select(next, true);
      });
    });

    // La búsqueda del navegador puede abrir un panel oculto: sincronizar la pestaña.
    panels.forEach((panel, i) => panel.addEventListener('beforematch', () => select(i)));
  }
</script>
