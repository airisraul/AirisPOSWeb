---
import Logo from './Logo.astro';
import { navLinks, site, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="pb-float border-t border-slate-800 bg-slate-950 pt-12 text-slate-300">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 md:grid-cols-3">
    <div>
      <Logo inverted />
      <p class="mt-4 max-w-xs">{site.tagline}. Para bares, cafeterías, restaurantes y delivery en toda España.</p>
    </div>

    <nav aria-label="Secciones">
      <p class="font-bold text-white">Secciones</p>
      <ul class="mt-4 space-y-1">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-10 items-center hover:text-white hover:underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="font-bold text-white">Contacto</p>
      <ul class="mt-4 space-y-1">
        <li>
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="inline-flex min-h-10 items-center hover:text-white hover:underline">
            Escríbenos por WhatsApp
          </a>
        </li>
        <li>
          <a href="#contacto" class="inline-flex min-h-10 items-center hover:text-white hover:underline">Pedir demo gratis</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="mx-auto mt-10 max-w-7xl border-t border-slate-800 px-4 pt-6 text-sm sm:px-6">
    <p>© {year} {site.name}. Todos los derechos reservados.</p>
  </div>
</footer>
