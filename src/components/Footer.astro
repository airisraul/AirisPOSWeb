---
import { Image } from 'astro:assets';
import logo from '../assets/marca/airispos-logo.jpg';
import { navLinks, pricing, site, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="theme-dark pb-float border-t border-night-line pt-14 text-mist">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 md:grid-cols-3">
    <div>
      <Image
        src={logo}
        alt={`${site.name} · ${site.company}`}
        widths={[176, 352]}
        sizes="176px"
        class="h-auto w-44 rounded-2xl"
      />
      <p class="mt-4 max-w-xs">{site.tagline}. Sala, cocina, reservas y gestión en un único sistema.</p>
    </div>

    <nav aria-label="Secciones">
      <p class="font-display font-bold text-white">Secciones</p>
      <ul class="mt-4 space-y-1">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-10 items-center hover:text-white hover:underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="font-display font-bold text-white">Contacto</p>
      <ul class="mt-4 space-y-1">
        <li>
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="inline-flex min-h-10 items-center hover:text-white hover:underline">
            Escríbenos por WhatsApp
          </a>
        </li>
        <li>
          <a href="#contacto" class="inline-flex min-h-10 items-center hover:text-white hover:underline">Reservar una demo</a>
        </li>
        <li>
          <a href="#precios" class="inline-flex min-h-10 items-center hover:text-white hover:underline">Probar {pricing.trialDays} días gratis</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="mx-auto mt-12 max-w-7xl border-t border-night-line px-4 pt-6 text-sm sm:px-6">
    <p>© {year} {site.name} · {site.company}</p>
  </div>
</footer>
