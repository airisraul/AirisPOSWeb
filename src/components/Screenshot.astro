---
// Captura del TPV servida en AVIF (y WebP como alternativa), con varios tamaños.
// Por defecto se carga en diferido; usa priority solo para la imagen principal (LCP).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes, priority = false, class: className } = Astro.props;
const widths = [480, 800, 1200, Math.min(src.width, 1600)].filter((w, i, all) => w <= src.width && all.indexOf(w) === i);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  quality={78}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={['h-auto w-full', className]}
/>
