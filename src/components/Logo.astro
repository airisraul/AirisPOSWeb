---
import { Image } from 'astro:assets';
import mark from '../assets/marca/airispos-mark.png';
---

<span class="inline-flex items-center gap-2.5 font-display text-lg font-bold tracking-tight text-white">
  <span class="grid size-9 shrink-0 place-items-center overflow-hidden rounded-full bg-white">
    <Image src={mark} alt="" width={72} height={62} loading="eager" class="h-auto w-7" />
  </span>
  <span>AIRISPOS</span>
</span>
