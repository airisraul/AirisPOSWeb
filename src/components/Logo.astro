---
interface Props {
  inverted?: boolean;
}

const { inverted = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2 text-xl font-extrabold tracking-tight', inverted ? 'text-white' : 'text-ink']}>
  <svg class="size-8 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#c2410c" />
    <path d="M9 23 15 9h2l6 14h-3.2l-1.3-3.2h-5l-1.3 3.2Zm5.5-5.8h3.2L16 13Z" fill="#fff" />
  </svg>
  <span>Airis<span class={inverted ? 'text-brand-500' : 'text-brand-700'}>POS</span></span>
</span>
