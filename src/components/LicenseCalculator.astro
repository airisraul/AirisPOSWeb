---
import { businessTypes, pricing, calculatePrice, formatPrice } from '../data/site';

const initial = { type: businessTypes[0].id, terminals: 1, waiterDevices: 2 };
const initialTotal = calculatePrice(initial.type, initial.terminals, initial.waiterDevices);
const { terminals: tLimits, waiterDevices: wLimits } = pricing.limits;
---

<section id="licencias" class="bg-white py-16 sm:py-24" aria-labelledby="licencias-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="font-bold tracking-wide text-brand-700 uppercase">Licencias</p>
      <h2 id="licencias-title" class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        Calcula tu licencia. Pagas una vez y es tuya
      </h2>
      <p class="mt-4 text-lg text-slate-700">
        Sin cuotas mensuales ni permanencias. Elige tu tipo de local y cuántos equipos necesitas, y verás el precio al momento.
      </p>
    </div>

    <form id="license-calculator" class="mt-10 grid gap-8 lg:grid-cols-5" aria-labelledby="licencias-title">
      <div class="space-y-8 rounded-2xl border border-slate-200 p-6 sm:p-8 lg:col-span-3">
        <fieldset>
          <legend class="text-lg font-bold text-ink">1. Tipo de local</legend>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {
              businessTypes.map((type) => (
                <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border-2 border-slate-300 px-4 py-3 font-semibold hover:border-slate-500 has-checked:border-brand-700 has-checked:bg-brand-50">
                  <input
                    type="radio"
                    name="type"
                    value={type.id}
                    checked={type.id === initial.type}
                    class="size-5 shrink-0 accent-brand-700"
                  />
                  {type.label}
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="grid gap-6 sm:grid-cols-2">
          {
            [
              { name: 'terminals', label: '2. Cajas principales (TPV)', hint: 'Pantallas donde se cobra.', value: initial.terminals, limits: tLimits },
              { name: 'waiterDevices', label: '3. Comanderos móviles o tablets', hint: 'Para tomar nota en mesa.', value: initial.waiterDevices, limits: wLimits },
            ].map((field) => (
              <div>
                <label for={`calc-${field.name}`} class="text-lg font-bold text-ink">
                  {field.label}
                </label>
                <p id={`calc-${field.name}-hint`} class="text-sm text-slate-600">
                  {field.hint}
                </p>
                <div class="mt-3 flex items-stretch overflow-hidden rounded-xl border-2 border-slate-300 focus-within:border-brand-700">
                  <button
                    type="button"
                    data-step="-1"
                    data-target={`calc-${field.name}`}
                    class="flex w-14 items-center justify-center bg-slate-100 text-2xl font-bold hover:bg-slate-200"
                    aria-label={`Quitar uno: ${field.label.slice(3)}`}
                  >
                    −
                  </button>
                  <input
                    id={`calc-${field.name}`}
                    name={field.name}
                    type="number"
                    inputmode="numeric"
                    min={field.limits.min}
                    max={field.limits.max}
                    value={field.value}
                    aria-describedby={`calc-${field.name}-hint`}
                    class="min-h-14 w-full min-w-0 border-0 text-center text-xl font-bold tabular-nums focus:outline-none"
                  />
                  <button
                    type="button"
                    data-step="1"
                    data-target={`calc-${field.name}`}
                    class="flex w-14 items-center justify-center bg-slate-100 text-2xl font-bold hover:bg-slate-200"
                    aria-label={`Añadir uno: ${field.label.slice(3)}`}
                  >
                    +
                  </button>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col rounded-2xl bg-ink p-6 text-white sm:p-8 lg:col-span-2">
        <p class="font-semibold text-slate-300">Precio estimado · pago único</p>
        <output
          id="calc-total"
          for="calc-terminals calc-waiterDevices"
          aria-live="polite"
          class="mt-1 block text-5xl font-extrabold tracking-tight tabular-nums"
        >
          {formatPrice(initialTotal)}
        </output>
        <p class="mt-1 text-sm text-slate-300">
          {pricing.vatIncluded ? 'IVA incluido.' : 'IVA no incluido.'} Te confirmamos el precio exacto en la demo.
        </p>

        <p class="mt-6 font-bold">Incluye:</p>
        <ul class="mt-3 space-y-2">
          {
            pricing.includes.map((item) => (
              <li class="flex gap-2 text-slate-100">
                <svg class="mt-0.5 size-5 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 12 5 5L20 7" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>

        <button
          type="submit"
          class="mt-8 inline-flex min-h-14 items-center justify-center rounded-xl bg-brand-600 px-6 text-lg font-bold text-ink hover:bg-brand-500"
        >
          Quiero esta configuración
        </button>
        <p class="mt-3 text-center text-sm text-slate-300">Te llevamos al formulario con todo ya rellenado.</p>
      </div>
    </form>
  </div>
</section>

<script>
  import { businessTypes, calculatePrice, formatPrice, type BusinessType } from '../data/site';

  const form = document.getElementById('license-calculator') as HTMLFormElement | null;
  const total = document.getElementById('calc-total') as HTMLOutputElement | null;

  if (form && total) {
    const terminals = form.elements.namedItem('terminals') as HTMLInputElement;
    const waiterDevices = form.elements.namedItem('waiterDevices') as HTMLInputElement;

    const clamp = (input: HTMLInputElement) => {
      const min = Number(input.min);
      const max = Number(input.max);
      const value = Math.round(Number(input.value));
      return Number.isFinite(value) ? Math.min(max, Math.max(min, value)) : min;
    };

    const read = () => ({
      type: (new FormData(form).get('type') as BusinessType) ?? 'bar',
      terminals: clamp(terminals),
      waiterDevices: clamp(waiterDevices),
    });

    const update = () => {
      const config = read();
      total.value = formatPrice(calculatePrice(config.type, config.terminals, config.waiterDevices));
    };

    form.addEventListener('input', update);
    // Al salir del campo, corregir valores fuera de rango (vacío, negativo, demasiado alto).
    form.addEventListener('focusout', (event) => {
      if (event.target === terminals || event.target === waiterDevices) {
        const input = event.target as HTMLInputElement;
        input.value = String(clamp(input));
        update();
      }
    });

    form.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-step]');
      if (!button) return;
      const input = document.getElementById(button.dataset.target ?? '') as HTMLInputElement;
      input.value = String(Math.min(Number(input.max), Math.max(Number(input.min), clamp(input) + Number(button.dataset.step))));
      update();
    });

    // Enviar la configuración al formulario de contacto.
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const config = read();
      const label = businessTypes.find((t) => t.id === config.type)?.label ?? '';
      const price = formatPrice(calculatePrice(config.type, config.terminals, config.waiterDevices));
      window.dispatchEvent(
        new CustomEvent('airis:prefill-contact', {
          detail: {
            type: config.type,
            comment: `Configuración calculada: ${label}, ${config.terminals} caja(s) TPV y ${config.waiterDevices} comandero(s). Precio estimado: ${price}.`,
          },
        }),
      );
    });

    // Los botones de las pestañas de sector preseleccionan el tipo de local.
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLElement>('[data-calc-type]');
      if (!link) return;
      const radio = form.querySelector<HTMLInputElement>(`input[name="type"][value="${link.dataset.calcType}"]`);
      if (radio) {
        radio.checked = true;
        update();
      }
    });
  }
</script>
