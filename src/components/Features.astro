---
import Screenshot from './Screenshot.astro';
import panelControl from '../assets/capturas/panel-control.png';

const features = [
  {
    title: 'Sábado noche sin internet, y tú sigues cobrando',
    text: 'AirisPOS trabaja dentro de tu local. Si se cae el wifi o la fibra, se sigue cobrando, abriendo mesas y mandando comandas a cocina. Cuando vuelve la conexión, todo se sincroniza solo.',
    icon: 'M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01M2 2l20 20',
  },
  {
    title: 'Cobro en barra en 2 toques',
    text: 'Toca el producto, toca cobrar. Botones grandes y claros para servir rápido en hora punta sin equivocarte de tecla.',
    icon: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
  },
  {
    title: 'Plano visual de mesas y terraza',
    text: 'Ve de un vistazo qué mesas están libres, ocupadas o pidiendo la cuenta. Mueve y junta mesas arrastrando con el dedo.',
    icon: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  },
  {
    title: 'Comandas directas a cocina y barra',
    text: 'Cada plato sale por la impresora o pantalla que toca: la bebida a barra, la comida a cocina. Sin papelitos ni gritos.',
    icon: 'M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z',
  },
  {
    title: 'Dividir la cuenta en segundos',
    text: 'A partes iguales, por productos o por comensal. Cada uno paga lo suyo, en efectivo o con tarjeta, sin hacer cuentas en una servilleta.',
    icon: 'M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5',
  },
  {
    title: 'Cierre de caja ciega en 1 minuto',
    text: 'Tu equipo cuenta el efectivo sin ver lo que debería haber. Tú ves las diferencias al momento, desde el TPV o desde el móvil.',
    icon: 'M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
  },
];
---

<section id="funcionalidades" class="bg-white py-16 sm:py-24" aria-labelledby="funcionalidades-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="font-bold tracking-wide text-brand-700 uppercase">Funcionalidades</p>
      <h2 id="funcionalidades-title" class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        Pensado para el ritmo real de un local, no para una oficina
      </h2>
      <p class="mt-4 text-lg text-slate-700">
        Menos tiempo detrás de la pantalla y más tiempo atendiendo. Estas son las cosas que notarás desde el primer turno.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <li>
            <article class="h-full rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <span class="flex size-12 items-center justify-center rounded-xl bg-brand-700 text-white">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={feature.icon} />
                </svg>
              </span>
              <h3 class="mt-4 text-xl font-bold text-ink">{feature.title}</h3>
              <p class="mt-2 leading-relaxed text-slate-700">{feature.text}</p>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 grid items-center gap-8 rounded-3xl bg-ink p-6 text-white sm:p-10 lg:grid-cols-3 lg:gap-12">
      <div>
        <h3 class="text-2xl font-bold">Tu negocio, de un vistazo</h3>
        <p class="mt-3 leading-relaxed text-slate-300">
          Desde el panel de control ves los ingresos, el ticket medio, las mesas activas, las ventas por categoría y qué camarero vende más, sin esperar al cierre.
        </p>
      </div>
      <figure class="lg:col-span-2">
        <Screenshot
          src={panelControl}
          alt="Panel de control de AirisPOS con los ingresos y el ticket medio de los últimos 30 días, las mesas activas y la ocupación en vivo, una gráfica de ingresos y pedidos, las ventas por categoría y el ranking de camareros."
          sizes="(min-width: 80rem) 760px, (min-width: 64rem) calc(66vw - 120px), calc(100vw - 80px)"
          class="rounded-xl ring-1 ring-white/10"
        />
      </figure>
    </div>
  </div>
</section>
