---
const items = [
  'Veri*Factu · AEAT',
  'TicketBAI Gipuzkoa',
  'TicketBAI Araba',
  'TicketBAI Bizkaia · BATUZ',
  'Multi-local',
  'Cadenas y franquicias',
];
const shield = 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4';
---

<section
  id="normativa"
  class="theme-dark loops marquee overflow-hidden border-y border-night-line bg-night-card py-6"
  aria-label="Normativa y tipos de negocio"
>
  <div class="[mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
  <div class="marquee-track flex w-max">
    {
      [false, true].map((duplicate) => (
        <ul class="flex shrink-0 gap-12 pr-12" aria-hidden={duplicate ? 'true' : undefined}>
          {items.map((item) => (
            <li class="flex items-center gap-2.5 font-display text-lg font-semibold whitespace-nowrap text-white/85 sm:text-xl">
              <svg class="size-5 shrink-0 text-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={shield} />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
  </div>
</section>
