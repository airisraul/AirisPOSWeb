---
import Screenshot from './Screenshot.astro';
import planoMesas from '../assets/capturas/plano-mesas.png';
import { formatPrice, lowestMonthlyPrice, pricing } from '../data/site';
---

<section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white" aria-labelledby="hero-title">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-10 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-2 lg:gap-16 lg:pt-20 lg:pb-24">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-800">
        <span class="size-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
        Preparado para Veri*factu y TicketBai
      </p>

      <h1 id="hero-title" class="text-4xl leading-[1.1] font-extrabold tracking-tight text-ink sm:text-5xl lg:text-6xl">
        El TPV que sigue cobrando <span class="text-brand-700">aunque se caiga internet</span>
      </h1>

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-700 sm:text-xl">
        Para bares, cafeterías, restaurantes y locales de delivery que no pueden permitirse parar. Cobra en
        barra en 2 toques, manda las comandas a cocina al momento y cierra caja en un minuto.
        <strong class="text-ink">Desde {formatPrice(lowestMonthlyPrice)}/mes, sin permanencia ni comisiones sobre tus ventas.</strong>
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#contacto"
          class="inline-flex min-h-14 items-center justify-center rounded-xl bg-brand-700 px-6 text-lg font-bold text-white shadow-lg shadow-brand-700/25 hover:bg-brand-800"
        >
          Probar {pricing.trialDays} días gratis
        </a>
        <a
          href="#precios"
          class="inline-flex min-h-14 items-center justify-center rounded-xl border-2 border-ink px-6 text-lg font-bold text-ink hover:bg-ink hover:text-white"
        >
          Ver planes y precios
        </a>
      </div>

      <ul class="mt-8 grid gap-2 text-sm font-medium text-slate-700 sm:grid-cols-2">
        {
          [`${pricing.trialDays} días de prueba gratis`, 'Sin permanencia: te das de baja cuando quieras', 'Usa tus impresoras y cajón actuales', 'Puesta en marcha gratis con el plan anual'].map(
            (item) => (
              <li class="flex items-center gap-2">
                <svg class="size-5 shrink-0 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 12 5 5L20 7" />
                </svg>
                {item}
              </li>
            ),
          )
        }
      </ul>
    </div>

    <figure class="relative">
      <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-100 via-white to-emerald-100 blur-2xl" aria-hidden="true"></div>
      <Screenshot
        src={planoMesas}
        priority
        sizes="(min-width: 80rem) 584px, (min-width: 64rem) calc(50vw - 56px), calc(100vw - 32px)"
        alt="Plano de mesas de AirisPOS en una tablet: mesas libres en verde, ocupadas en rojo con su importe y tiempo, y reservadas en naranja, junto a la barra, la caja y la cocina."
        class="drop-shadow-2xl"
      />
      <figcaption class="mt-3 text-center text-sm text-slate-600">Plano de mesas en tiempo real: ves qué está libre, ocupado o reservado.</figcaption>
    </figure>
  </div>
</section>
