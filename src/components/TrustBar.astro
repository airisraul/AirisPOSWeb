---
// PENDIENTE: cuando tengáis datos reales (nº de locales, años en el mercado, valoración media),
// se pueden añadir aquí. No conviene publicar cifras que no se puedan demostrar.
const items = [
  {
    title: 'Funciona sin internet',
    text: 'Cobras y mandas comandas aunque se corte la conexión.',
    icon: 'M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01M2 2l20 20',
  },
  {
    title: 'Soporte técnico directo',
    text: 'Por teléfono y WhatsApp, también en fin de semana.',
    icon: 'M3 14v-3a9 9 0 0 1 18 0v3M21 15a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2zM3 15a2 2 0 0 0 2 2h1v-6H5a2 2 0 0 0-2 2z',
  },
  {
    title: 'Normativa fiscal al día',
    text: 'Adaptado a Veri*factu y TicketBai.',
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4',
  },
  {
    title: 'Instalación incluida',
    text: 'Te lo dejamos funcionando con tu carta cargada.',
    icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  },
];
---

<section class="border-y border-slate-200 bg-ink text-white" aria-label="Por qué elegir AirisPOS">
  <ul class="mx-auto grid max-w-7xl gap-6 px-4 py-8 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:py-10">
    {
      items.map((item) => (
        <li class="flex gap-3">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-brand-500">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={item.icon} />
            </svg>
          </span>
          <div>
            <p class="font-bold">{item.title}</p>
            <p class="text-sm text-slate-300">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
